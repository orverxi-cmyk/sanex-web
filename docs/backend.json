
{
  "entities": {
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "An image with a description for the SANEX gallery.",
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "description": "The URL of the image."
        },
        "description": {
          "type": "string",
          "description": "A description of the photo."
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when added."
        }
      },
      "required": [
        "imageUrl",
        "description",
        "createdAt"
      ]
    },
    "HeroSettings": {
      "type": "object",
      "properties": {
        "badge": { "type": "string" },
        "title": { "type": "string" },
        "titleAccent": { "type": "string" },
        "description": { "type": "string" },
        "ctaText": { "type": "string" },
        "ctaLink": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "SliderItem": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "link": { "type": "string" },
        "buttonText": { "type": "string" }
      }
    },
    "GeneralSettings": {
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "HighlightItem": {
      "type": "object",
      "properties": {
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ServiceItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "ImpactItem": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "icon": { "type": "string" },
        "points": { "type": "array", "items": { "type": "string" } }
      }
    },
    "MilestoneItem": {
      "type": "object",
      "properties": {
        "year": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "RegionItem": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "status": { "type": "string" },
        "capacity": { "type": "string" }
      }
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global settings and section content for the website.",
      "type": "object",
      "properties": {
        "general": { "$ref": "#/entities/GeneralSettings" },
        "hero": { "$ref": "#/entities/HeroSettings" },
        "slider": { "type": "array", "items": { "$ref": "#/entities/SliderItem" } },
        "highlights": { "type": "array", "items": { "$ref": "#/entities/HighlightItem" } },
        "services": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "items": { "type": "array", "items": { "$ref": "#/entities/ServiceItem" } }
          }
        },
        "impact": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "items": { "type": "array", "items": { "$ref": "#/entities/ImpactItem" } }
          }
        },
        "milestones": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "items": { "type": "array", "items": { "$ref": "#/entities/MilestoneItem" } }
          }
        },
        "regional": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "items": { "type": "array", "items": { "$ref": "#/entities/RegionItem" } }
          }
        },
        "video": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "videoUrl": { "type": "string" }
          }
        }
      }
    },
    "User": {
      "title": "User Profile",
      "description": "User metadata and permissions.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "lastLogin": { "type": "number" }
      }
    },
    "Booking": {
      "title": "Service Booking",
      "description": "A service request from a customer.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "serviceType": { "type": "string" },
        "locationUrl": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "number" }
      },
      "required": ["customerName", "email", "phone", "serviceType", "locationUrl", "createdAt", "status"]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "/gallery/{itemId}": {
      "schema": "#/entities/GalleryItem",
      "description": "Collection of gallery photos."
    },
    "/settings/{sectionId}": {
      "schema": "#/entities/SiteSettings",
      "description": "Site configuration sections (hero, services, highlights, general etc)."
    },
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "Stored user permissions and profile data."
    },
    "/bookings/{bookingId}": {
      "schema": "#/entities/Booking",
      "description": "Customer service requests."
    }
  }
}
