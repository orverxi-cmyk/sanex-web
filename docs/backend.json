{
  "entities": {
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "An image with a description for the SANEX gallery.",
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "description": "The URL of the image."
        },
        "description": {
          "type": "string",
          "description": "A description of the photo."
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when added."
        }
      },
      "required": [
        "imageUrl",
        "description",
        "createdAt"
      ]
    },
    "SiteSettings": {
      "title": "Site Settings",
      "description": "Global settings for the website.",
      "type": "object",
      "properties": {
        "heroVideoUrl": {
          "type": "string",
          "description": "URL for the homepage highlight video."
        }
      }
    },
    "User": {
      "title": "User Profile",
      "description": "User metadata and permissions.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "user"]
        },
        "lastLogin": {
          "type": "number"
        }
      }
    },
    "Booking": {
      "title": "Service Booking",
      "description": "A service request from a customer.",
      "type": "object",
      "properties": {
        "customerName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "serviceType": { "type": "string" },
        "locationUrl": { "type": "string", "description": "Google Maps or similar link." },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "number" }
      },
      "required": ["customerName", "email", "phone", "serviceType", "locationUrl", "createdAt", "status"]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "/gallery/{itemId}": {
      "schema": "#/entities/GalleryItem",
      "description": "Collection of gallery photos."
    },
    "/settings/general": {
      "schema": "#/entities/SiteSettings",
      "description": "General site configuration."
    },
    "/users/{userId}": {
      "schema": "#/entities/User",
      "description": "Stored user permissions and profile data."
    },
    "/bookings/{bookingId}": {
      "schema": "#/entities/Booking",
      "description": "Customer service requests."
    }
  }
}